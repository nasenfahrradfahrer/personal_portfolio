# Optional – nach frontend/.env.local kopieren. Achtung: VITE_-Variablen landen im
# öffentlichen JavaScript. Hier gehören deshalb NIE geheime Schlüssel hinein.

# Adresse der Chat-API, falls das Backend auf einer anderen Domain läuft (Standard: /api)
# VITE_CHAT_API_URL=https://api.example.com/api

# Öffentlicher Site Key von Cloudflare Turnstile (der Secret Key gehört ins Backend)
# VITE_TURNSTILE_SITE_KEY=
