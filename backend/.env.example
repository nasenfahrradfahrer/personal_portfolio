# Vorlage: kopieren nach backend/.env und ausfüllen. Die .env gehört NICHT ins Repository.

# --- Sprachmodell -----------------------------------------------------------------
# API-Schlüssel aus der Anthropic Console (console.anthropic.com). Nie ins Frontend!
ANTHROPIC_API_KEY=
# Modell: claude-opus-5-5 (Standard), günstiger: claude-sonnet-5-5 oder claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-5-5
# Denkaufwand: low (für kurze Chat-Antworten), medium, high. Bei claude-haiku-4-5 wird er ignoriert.
ANTHROPIC_EFFORT=low
# Ersatzmodell, falls die Sicherheitsfilter eine Anfrage ablehnen: auto | on | off
ANTHROPIC_FALLBACKS=auto
MAX_OUTPUT_TOKENS=4096
# Testmodus ohne API-Aufrufe (zeigt nur, was die Suche findet; kostet nichts)
CHAT_DRY_RUN=false

# --- Über dich ----------------------------------------------------------------------
OWNER_NAME=Felix Möller
# Optional, z. B. "er/ihm" oder "sie/ihr". Leer = der Assistent nutzt den Namen statt Pronomen.
OWNER_PRONOUNS=
CONTACT_HINT=über den Kontaktbereich der Webseite

# --- Schutzmaßnahmen ----------------------------------------------------------------
# Geheimer Schlüssel zum Signieren des Gesprächsverlaufs. Erzeugen mit:
#   python -c "import secrets; print(secrets.token_hex(32))"
CHAT_SIGNING_SECRET=
# Erlaubte Herkunft der Webseite (CORS), kommagetrennt. In Produktion die echte Domain eintragen.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
MAX_MESSAGE_CHARS=1000
MAX_TURNS=10
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_DAY=60
MAX_CONCURRENT_STREAMS=4
# Geschätzte API-Kosten pro Tag (UTC), danach pausiert der Chat. 0 = kein Limit.
DAILY_BUDGET_USD=2.00
# Nur auf true setzen, wenn ein eigener Reverse-Proxy (Caddy, nginx) davor steht
TRUST_PROXY_HEADERS=false
# Optionaler Bot-Schutz mit Cloudflare Turnstile (Secret Key; Site Key gehört ins Frontend)
TURNSTILE_SECRET_KEY=

# --- Kontaktformular (Impressum) ------------------------------------------------------
# Nachrichten werden per SMTP an CONTACT_TO weitergeleitet und nicht gespeichert.
# Ohne SMTP_HOST/CONTACT_TO antwortet das Formular mit „gerade nicht verfügbar“.
# Port 465 = TLS von Anfang an, sonst STARTTLS (z. B. 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Empfänger (dein Postfach) und Absender (Standard: SMTP_USER)
CONTACT_TO=
CONTACT_FROM=
# Nachrichten pro IP und Tag (zusätzlich höchstens 2 pro Minute)
CONTACT_LIMIT_PER_DAY=5

# --- Wissensbasis -------------------------------------------------------------------
# Privates Repo mit documents/, raw/ und techstack*.json; Klon mit `python -m app.cli fetch-knowledge`.
# Lokal reichen die gespeicherten HTTPS-Zugangsdaten von Git. Im Container setzt compose.yaml
# KNOWLEDGE_REPO auf die SSH-Adresse (Deploy Key).
KNOWLEDGE_REPO=https://github.com/nasenfahrradfahrer/portfolio_website_private_files.git
KNOWLEDGE_BRANCH=master
# Ordner des Klons (Standard: knowledge/private, nicht in Git)
# KNOWLEDGE_DIR=knowledge/private
# Lokales Embedding-Modell für die Bedeutungssuche; "none" = nur Stichwortsuche
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RETRIEVAL_TOP_K=6
# Standard: techstack.json im Klon; "none" = Tech-Stack weder indexieren noch ausliefern
# TECHSTACK_PATH=knowledge/private/techstack.json

# --- Betrieb ------------------------------------------------------------------------
# Gespräche (Fragen und Antworten, ohne IP) in data/chats.jsonl speichern, um den Assistenten zu
# verbessern. Die Datenschutzerklärung beschreibt das mit 30 Tagen Löschfrist: Ändert sich die Frist,
# frontend/src/pages/Privacy.jsx anpassen. (Früherer Name: LOG_QUESTIONS, gilt weiter.)
LOG_CHATS=false
LOG_RETENTION_DAYS=30
# Optional: gebautes Frontend (frontend/dist) direkt vom Backend ausliefern
SERVE_FRONTEND_DIR=
